<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ScorpioConcepts.Framework.DBSchema</PackageId>
    <Version>2.0.0</Version>
    <Title>Scorpio Concepts Database Schema</Title>
    <Description>Keeps a SQL Server database structure in sync with a schema defined in a JSON, DBML or XML file</Description>
    <Authors>Scorpio Concepts</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/ScorpioConcepts/ScorpioConcepts.Framework</PackageProjectUrl>
    <PackageReleaseNotes>Targets .NET 10 and .NET Standard 2.0. .NET Framework targets have been dropped. Uses Microsoft.Data.SqlClient instead of System.Data.SqlClient. Schemas are now generated as JSON by default; XML schema files are still fully supported, and ConvertSchema converts between the two.</PackageReleaseNotes>
    <PackageVersion>2.0.0</PackageVersion>
    <Copyright>Copyright Scorpio Concepts 2026</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ScorpioConcepts/ScorpioConcepts.Framework.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScorpioConcepts.Framework.DBSchema.Tests" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 6.0+ no longer ships a .NET Standard build, so netstandard2.0 stays on the 5.2 line -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
    <!-- Built into .NET 10, a package for .NET Standard -->
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>
</Project>
