<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ScorpioConcepts.Framework.DBSchema</PackageId>
    <Version>2.1.0</Version>
    <!-- The last version on NuGet.org. Pack fails if the public API breaks compared with it; update it after each release -->
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
    <Title>Scorpio Concepts Database Schema</Title>
    <Description>Keeps a SQL Server database structure in sync with a schema defined in a JSON, DBML or XML file</Description>
    <PackageReleaseNotes>Adds DBML (the language of dbdiagram.io) as a third schema file format, as DBSchemaFormat.Dbml. Load, CheckDatabaseSchema and ConvertSchema recognise DBML from its content, and GenerateSchema and Save write it. Files written by the library are valid DBML for other DBML tools. Names DBML leaves optional are generated (PK_table, IX_table_columns, FK_table_columns). Things DBML has no syntax for use custom properties: clustered_index on a table, and identity_seed, identity_increment, default_name and persisted on a column. In records, null or an empty field inserts NULL and `DEFAULT` uses the column default. DBML that DBSchema cannot create, such as enums, checks, other schemas and many-to-many refs, is rejected with an error that gives the line and column. Format detection now skips leading // and /* */ comments, so a JSON file that starts with a comment is recognised too.</PackageReleaseNotes>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScorpioConcepts.Framework.DBSchema.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 6.0+ no longer ships a .NET Standard build, so netstandard2.0 stays on the 5.2 line -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
    <!-- Built into .NET 10, a package for .NET Standard -->
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>
</Project>
