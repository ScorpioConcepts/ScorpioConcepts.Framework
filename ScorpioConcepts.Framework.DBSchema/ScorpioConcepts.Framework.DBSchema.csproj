<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ScorpioConcepts.Framework.DBSchema</PackageId>
    <Version>2.0.0</Version>
    <Title>Scorpio Concepts Database Schema</Title>
    <Description>Keeps a SQL Server database structure in sync with a schema defined in an XML file</Description>
    <Authors>Scorpio Concepts</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/ScorpioConcepts/ScorpioConcepts.Framework</PackageProjectUrl>
    <PackageReleaseNotes>Targets .NET 10 and .NET Standard 2.0. .NET Framework targets have been dropped. Uses Microsoft.Data.SqlClient instead of System.Data.SqlClient.</PackageReleaseNotes>
    <PackageVersion>2.0.0</PackageVersion>
    <Copyright>Copyright Scorpio Concepts 2026</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ScorpioConcepts/ScorpioConcepts.Framework.git</RepositoryUrl>
  </PropertyGroup>

  <!-- Microsoft.Data.SqlClient 6.0+ no longer ships a .NET Standard build, so netstandard2.0 stays on the 5.2 line -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
  </ItemGroup>
</Project>
