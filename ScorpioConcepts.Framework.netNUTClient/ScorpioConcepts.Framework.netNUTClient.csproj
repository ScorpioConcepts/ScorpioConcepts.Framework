<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ScorpioConcepts.Framework.netNUTClient</PackageId>
    <Version>3.0.0</Version>
    <Title>Scorpio Concepts .NET NUT Client</Title>
    <Description>Scorpio Concepts Library providing basics for a NUT client</Description>
    <Authors>Scorpio Concepts</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/ScorpioConcepts/ScorpioConcepts.Framework</PackageProjectUrl>
    <PackageReleaseNotes>Targets .NET 10 and .NET Standard 2.0. .NET Framework targets have been dropped.</PackageReleaseNotes>
    <PackageVersion>3.0.0</PackageVersion>
    <Copyright>Copyright Scorpio Concepts 2026</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ScorpioConcepts/ScorpioConcepts.Framework.git</RepositoryUrl>
  </PropertyGroup>
</Project>
